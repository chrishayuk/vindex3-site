{
	"name": "vindex3",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "next lint",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv ./cloudflare-env.d.ts",
		"test": "npm run check:hause && tsx scripts/ask-coverage.ts && tsx scripts/connection-invariants.ts && tsx --test scripts/archive-policy.test.ts",
		"archive": "tsx scripts/archive-wayback.ts",
		"check:hause": "node node_modules/@chrishayuk/hause/scripts/consumer-sync.mjs",
		"sync:larql": "tsx scripts/ingest-spec.ts",
		"check:larql": "tsx scripts/ingest-spec.ts --check",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@chrishayuk/hause": "github:chrishayuk/hause#60efcd6555bb688676944f891da1076f888ccda0",
		"@opennextjs/cloudflare": "^1.20.3",
		"next": "16.3.3",
		"react": "^19.1.7",
		"react-dom": "^19.1.7"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20.19.43",
		"@types/react": "^19.1.7",
		"@types/react-dom": "^19.1.7",
		"eslint": "^9",
		"eslint-config-next": "16.3.3",
		"tailwindcss": "^4",
		"tsx": "^4.23.12",
		"typescript": "^5.7.4",
		"wrangler": "^4.127.1"
	}
}
